[Script]
# 精准拦截广告下发接口，交由脚本判断并只剔除开屏部分
http-response ^https:\/\/efly\.partner\.huawei\.com\/eplusSmb-cn\/agw\/.*\/findNewAdvertise script-path = https://raw.githubusercontent.com/2Vrkswz/HuaweiEnterprise_NoAD/refs/heads/main/huawei_enterprise.js, requires-body = true, tag = 移除开屏广告

[Mitm]
hostname = efly.partner.huawei.com
